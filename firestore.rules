rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access to root or unlisted collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Strict User Isolation under /users/{userId}
    match /users/{userId} {
      // Allow authenticated user to read/write their own document
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Allow authenticated user full CRUD on any subcollection under their own path
      match /{allPaths=**} {
        allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
